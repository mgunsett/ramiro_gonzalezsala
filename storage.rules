rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Estructura legacy (landing original de cainfara): shields/{archivo}
    // Se mantiene intacta para no romper el sitio ya en producción.
    match /shields/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Estructura nueva multi-jugador: players/{slug}/shields/{archivo}
    match /players/{slug}/shields/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Imágenes de Instagram cargadas a mano desde /admin (máx. 5 MB)
    match /players/{slug}/instagram/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && (request.resource == null
                       || (request.resource.size < 5 * 1024 * 1024
                           && request.resource.contentType.matches('image/.*')));
    }
  }
}
